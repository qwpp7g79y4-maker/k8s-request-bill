{
  "apiVersion": "v1",
  "kind": "PodList",
  "items": [
    {
      "metadata": { "namespace": "apps", "name": "api-0" },
      "spec": {
        "containers": [
          {
            "name": "api",
            "resources": {
              "requests": { "cpu": "200m", "memory": "256Mi" },
              "limits": { "cpu": "1", "memory": "1Gi" }
            }
          }
        ]
      }
    },
    {
      "metadata": { "namespace": "apps", "name": "worker-0" },
      "spec": {
        "containers": [
          {
            "name": "worker",
            "resources": {
              "requests": { "cpu": "500m", "memory": "512Mi" }
            }
          }
        ]
      }
    },
    {
      "metadata": { "namespace": "kube-system", "name": "coredns-a" },
      "spec": {
        "containers": [
          {
            "name": "coredns",
            "resources": {
              "requests": { "cpu": "100m", "memory": "70Mi" }
            }
          }
        ]
      }
    }
  ]
}
